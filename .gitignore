# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt


# Python bytecode caches
__pycache__/
*.py[cod]

# Python virtual environments
.venv/
venv/

# Python packaging artifacts (pip install -e python/, wheel builds)
*.egg-info/
/python/build/
/python/dist/

# macOS finder metadata
.DS_Store

# Model weights downloaded at runtime by the detection example
*.pt

# local developer's files
.local/

# VMAF quality-test artifacts (captures, scores, logs)
/vmaf-test/runs/